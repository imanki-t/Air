# Base URL of the Airstream backend API (no trailing slash)
VITE_BACKEND_URL=http://localhost:5000

# Google OAuth 2.0 Client ID — must match GOOGLE_CLIENT_ID on the backend
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional — Google reCAPTCHA site key (leave blank if the backend has no
# RECAPTCHA_SECRET_KEY set)
VITE_RECAPTCHA_SITE_KEY=
