# ── Core ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/airstream

# Random secret for signing session JWTs
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Exact frontend origin (no trailing slash) — used for CORS + Socket.IO
FRONTEND_URL=http://localhost:5173

# Public URL of this backend (used to build absolute links, e.g. in emails)
BACKEND_URL=http://localhost:5000

# ── Google OAuth / Drive ────────────────────────────────────────────────
# Same Client ID as the frontend's VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# 32-byte key, base64-encoded — encrypts Drive refresh tokens at rest
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DRIVE_TOKEN_ENCRYPTION_KEY=

# ── Email (optional — welcome emails, data export links) ───────────────
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground

# ── Bot protection (optional but recommended in production) ────────────
RECAPTCHA_SECRET_KEY=

# ── Cloudflare R2 (currently unused — Drive is the active storage backend) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
